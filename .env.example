# Native standalone application settings. Never commit a real .env file.
CAREERFORGE_DATA_DIR=./data
CAREERFORGE_DATABASE_URL=sqlite:///./data/careerforge.db
CAREERFORGE_SESSION_SECRET=replace-with-a-long-random-value
CAREERFORGE_BIND_HOST=127.0.0.1
CAREERFORGE_BIND_PORT=8787
CAREERFORGE_SECURE_COOKIES=false
