# CareerForge local configuration. Copy to .env; do not commit the copy.
CAREERFORGE_DATA_DIR=
CAREERFORGE_HOST=127.0.0.1
CAREERFORGE_PORT=8000
CAREERFORGE_SESSION_TIMEOUT_MINUTES=60
CAREERFORGE_COOKIE_SECURE=false
CAREERFORGE_ALLOW_PRIVATE_HTTP=true
CAREERFORGE_MAX_AI_RESPONSE_BYTES=1048576
# Generate a 32-byte Fernet key during bootstrap. Keep this value private.
CAREERFORGE_ENCRYPTION_KEY=
